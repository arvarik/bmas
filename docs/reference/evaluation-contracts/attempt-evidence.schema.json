{
  "$defs": {
    "money": {
      "additionalProperties": false,
      "properties": {
        "amount_nanos": {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775807,
          "type": "integer"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        }
      },
      "required": [
        "currency",
        "amount_nanos"
      ],
      "type": "object"
    }
  },
  "$id": "bmas/attempt-evidence",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "type": "array"
    },
    "attempt_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$",
      "type": "string"
    },
    "board_state_reference": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$",
      "type": "string"
    },
    "case_reference": {
      "additionalProperties": false,
      "properties": {
        "asset_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$",
            "type": "string"
          },
          "type": "array"
        },
        "case_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$",
          "type": "string"
        }
      },
      "required": [
        "case_id"
      ],
      "type": "object"
    },
    "completeness": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "complete",
            "partial_legacy"
          ]
        },
        "unavailable_sections": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "level",
        "unavailable_sections"
      ],
      "type": "object"
    },
    "failure_classification": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "final_output_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "final_state_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "ledger_references": {
      "additionalProperties": false,
      "properties": {
        "admission_effect_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$",
          "type": "string"
        },
        "reservation_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$",
          "type": "string"
        },
        "resource_ledger_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "recovery_events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "resources": {
      "additionalProperties": false,
      "properties": {
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/money"
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "tokens": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cost",
        "tokens",
        "latency_ms"
      ],
      "type": "object"
    },
    "run_manifest_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "runtime_specification_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "schema_id": {
      "const": "attempt-evidence"
    },
    "schema_version": {
      "const": 2
    },
    "seed_evidence": {
      "additionalProperties": false,
      "properties": {
        "applied_seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "requested_seed": {
          "type": "integer"
        },
        "seed_control": {
          "enum": [
            "recorded",
            "best_effort",
            "applied"
          ]
        }
      },
      "required": [
        "requested_seed",
        "seed_control"
      ],
      "type": "object"
    },
    "tool_calls_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "trace_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "verification_decisions_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "versions": {
      "additionalProperties": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "attempt_id",
    "run_manifest_digest",
    "runtime_specification_digest",
    "case_reference",
    "trace_digest",
    "final_output_digest",
    "resources",
    "completeness",
    "seed_evidence",
    "versions",
    "ledger_references"
  ],
  "title": "One immutable evidence bundle for one attempt",
  "type": "object"
}
