{
  "$defs": {
    "money": {
      "additionalProperties": false,
      "properties": {
        "amount_nanos": {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775807,
          "type": "integer"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        }
      },
      "required": [
        "currency",
        "amount_nanos"
      ],
      "type": "object"
    }
  },
  "$id": "bmas/score-record",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "calibration_version": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "dimensions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$",
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 20000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_references": {
      "items": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$",
        "type": "string"
      },
      "type": "array"
    },
    "explanation": {
      "maxLength": 20000,
      "type": "string"
    },
    "judge": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "request_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "response_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "usage": {
          "additionalProperties": false,
          "properties": {
            "completion_tokens": {
              "minimum": 0,
              "type": "integer"
            },
            "prompt_tokens": {
              "minimum": 0,
              "type": "integer"
            },
            "provider_cost_text": {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            "total_tokens": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "request_digest",
        "response_digest"
      ],
      "type": "object"
    },
    "passed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "sandbox": {
      "additionalProperties": false,
      "properties": {
        "boundary": {
          "enum": [
            "trusted_service",
            "wasi_component",
            "native_microvm"
          ]
        },
        "compiler_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "component_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "dependency_lock_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "fuel_used": {
          "minimum": 0,
          "type": "integer"
        },
        "output_schema_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "policy_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "replay_eligible": {
          "type": "boolean"
        },
        "runtime_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "terminal_class": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "wit_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "boundary",
        "policy_digest",
        "runtime_digest"
      ],
      "type": "object"
    },
    "schema_id": {
      "const": "score-record"
    },
    "schema_version": {
      "const": 2
    },
    "score_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$",
      "type": "string"
    },
    "scorer": {
      "additionalProperties": false,
      "properties": {
        "configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "scorer_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$",
          "type": "string"
        },
        "version": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "scorer_id",
        "version",
        "configuration_digest"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "scored",
        "error",
        "excluded"
      ]
    },
    "uncertainty": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "score_id",
    "scorer",
    "evidence_references",
    "dimensions",
    "explanation",
    "status"
  ],
  "title": "One named-dimension score record",
  "type": "object"
}
