# ─────────────────────────────────────────────────────────────────────
# bMAS — Environment Variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# This file is loaded by Docker Compose. NEVER commit .env to git.

# ── Required ───────────────────────────────────────────────────────

# Redis password (used by all services that connect to Redis)
REDIS_PASSWORD=

# LiteLLM master key (authenticates requests from daemon → LiteLLM)
LITELLM_MASTER_KEY=

# Shared bearer secret for agent-to-daemon authentication.
# Generate with: openssl rand -hex 32
BMAS_NODE_KEY=

# Daemon-to-agent execution key. The starter command generates this value.
BMAS_EXECUTE_KEY=

# Optional operator key for task submission and control mutations.
# Set the same value on the daemon, dashboard, and evaluation runner.
BMAS_API_KEY=

# Optional Mission Control access key. The browser requests it as a password.
# Keep this value separate from BMAS_API_KEY.
BMAS_DASHBOARD_KEY=

# ── Cloud API Keys (add the ones you use) ──────────────────────────
# At least one is required unless routing everything to local models.

GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Optional ───────────────────────────────────────────────────────

# Bind published ports to loopback by default. Use 0.0.0.0 only on a trusted
# LAN or behind a configured firewall and reverse proxy.
# BMAS_BIND_ADDRESS=127.0.0.1

# Default model used by the starter execution service.
# BMAS_STARTER_MODEL=starter-model

# Global long-task admission limits.
# BMAS_MAX_ACTIVE_TASKS=4
# BMAS_MAX_QUEUED_TASKS=100
# BMAS_MAX_TASK_CHARS=200000
# BMAS_SHUTDOWN_GRACE_S=30
# BMAS_AGENT_TURN_TIMEOUT_S=600
# BMAS_AGENT_ENDPOINT_MAX_CONCURRENCY=4
# BMAS_AGENT_ENDPOINT_WAIT_TIMEOUT_S=30
# BMAS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# BMAS_CIRCUIT_BREAKER_RECOVERY_S=30

# Durable event delivery and replay limits.
# BMAS_EVENT_PAYLOAD_MAX_BYTES=1048576
# BMAS_EVENT_OUTBOX_MAX=10000
# BMAS_EVENT_OUTBOX_OVERLOAD=5000
# BMAS_EVENT_OUTBOX_BATCH=100
# BMAS_EVENT_REPLAY_PAGE=250

# Maximum task projections retained in daemon memory.
# BMAS_BOARD_PROJECTION_CACHE_TASKS=128

# Comma-separated list of IPs/hostnames for Next.js dev server access.
# Required when accessing Mission Control from a LAN IP other than localhost.
# ALLOWED_DEV_ORIGINS=192.168.1.100,my-dev-host.local

# ── Local Triage Backend (optional) ────────────────────────────────
# These are only needed when triage.backend is set to "local" in bmas.yaml.
# The default "cloud" backend uses the model from bmas.yaml. It needs no
# extra local triage configuration.

# Hugging Face token (for downloading gated Qwen3 model)
# HF_TOKEN=

# vLLM container overrides (must match bmas.yaml triage section)
# TRIAGE_MODEL=Qwen/Qwen3-1.7B
# TRIAGE_GPU_MEMORY=0.35
# TRIAGE_MAX_MODEL_LEN=8192

# ── Monitoring (Beszel) ────────────────────────────────────────────
# Credentials for the Beszel Hub (PocketBase). Required for hardware
# telemetry (CPU, RAM, thermals) on the Infrastructure page.
# These are the email/password you use to log into the Beszel web UI.
# The Hub URL itself is configured in bmas.yaml under monitoring.beszel_hub.

# BESZEL_EMAIL=
# BESZEL_PASSWORD=
