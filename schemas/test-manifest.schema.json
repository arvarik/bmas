{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_id": "bmas.test_manifest",
  "title": "Authoritative repository test manifest",
  "description": "The root registry of every repository check. Each entry declares one lifecycle state, one exact command as an argument array, and one owner. Contract versions live only in explicit metadata values.",
  "metadata": {
    "contract_version": "1.0.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "metadata", "groups", "profiles"],
  "properties": {
    "schema_id": { "const": "bmas.test_manifest" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version"],
      "properties": {
        "contract_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$",
      "maxLength": 120
    },
    "group": {
      "oneOf": [
        { "$ref": "#/$defs/activeGroup" },
        { "$ref": "#/$defs/reservedGroup" },
        { "$ref": "#/$defs/retiredGroup" }
      ]
    },
    "activeGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "owner",
        "purpose",
        "argv",
        "working_directory",
        "timeout_seconds",
        "tools"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "state": { "enum": ["active_required", "active_optional"] },
        "owner": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "working_directory": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$"
        },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "depends_on": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "passthrough": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "set": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "parser": { "enum": ["exit_status", "pytest_summary"] },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_attempts"],
          "properties": {
            "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$"
          }
        }
      }
    },
    "reservedGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "owner", "purpose", "activation_stage"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "state": { "const": "reserved" },
        "owner": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "activation_stage": { "type": "string", "minLength": 1 }
      }
    },
    "retiredGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "owner", "purpose", "retirement_note"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "state": { "const": "retired" },
        "owner": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "retirement_note": { "type": "string", "minLength": 1 },
        "replacement": {
          "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "selector"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1 },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [{ "required": ["states"] }, { "required": ["groups"] }],
          "properties": {
            "states": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["active_required", "active_optional"] },
              "uniqueItems": true
            },
            "groups": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/identifier" },
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}
